+def load_new_helper(name: str, prepared: dict[str, Any]) -> Any:
+    """Load only this new, honestly pinned stdlib wrapper."""
+    root = Path(__file__).absolute().parent
+    expected = prepared["implementation_source_sha256"][name]
+    io.require(io.sha(root / name) == expected, "new location helper differs")
+    namespace = "location_core" if name == "location_core.py" else "_capture_per_entry_" + name.removesuffix(".py")
+    if namespace in sys.modules:
+        module = sys.modules[namespace]
+        io.require(Path(module.__file__).absolute() == root / name and io.sha(root / name) == expected,
+                   "existing location helper is foreign")
+        return module
+    spec = importlib.util.spec_from_file_location(namespace, root / name)
+    io.require(spec is not None and spec.loader is not None and namespace not in sys.modules,
+               "location helper namespace unavailable")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[namespace] = module
+    spec.loader.exec_module(module)
+    io.require(io.sha(root / name) == expected, "new location helper changed")
+    return module
 
 

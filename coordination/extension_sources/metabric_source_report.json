  "platform_and_processing": {
    "pinned_metadata_verified": "Measured CONTINUOUS expression log2 intensity levels, Illumina HT-12 v3 microarray; no further logarithm should be applied.",
    "original_study_workflow": "Curtis et al. 2012 supplementary methods 4.1, pp.5-6: beadarray/BASH spatial artefact adjustment and summarization of log2 intensity; quality control; ER-positive and ER-negative sample quantile target distributions averaged; interpolation for other probes; limma correction for BeadChip-position batch effects.",
    "lineage_limit": "Pinned DataHub profile does not document the full probe-to-gene aggregation/curation history. Original-study methods describe upstream published processing, not a proven byte-level recreation of this curated gene matrix.",
    "benchmark_limit": "Use as a benchmark conditional on immutable publicly processed expression. Upstream cohort normalization is already embedded and cannot be refit inside model folds from this matrix; do not claim a fully prospective raw-assay pipeline.",
    "original_primary_source_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3440846/",
    "supplement_archive_url": "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3440846/supplementaryFiles",
    "supplement_archive_member": "NIHMS45243-supplement-1.pdf",
    "supplement_local_path": "/Users/macuser/bayes-cox-runs/extension-reference-20260928/metabric/curtis_2012_supplement_methods.pdf",
    "supplement_sha256": "17ca72e029eadad4f08a392847fe92a024621839fde4b567bd6965b66bd6ae4e"
  },
  "timing": {
    "verified": "All pinned clinical sample records specify Primary; original study describes clinically annotated primary fresh-frozen breast cancer specimens. Expression therefore represents sampled primary tumour tissue, rather than longitudinal or metastatic measurements.",
    "unresolved": "Pinned files provide no specimen acquisition date, expression report date, or treatment start dates. Do not assert pretreatment availability, exact surgery/diagnosis clock alignment, or prospective deployment from these files. Treatment histories are not verified baseline covariates."
  },
  "recommended_preprocessing": {
    "cohort": "Use only explicit SAMPLE_ID -> PATIENT_ID joins, one expression sample per patient. For OS retain recognized binary OS_STATUS and finite OS_MONTHS >0: 1979 rows. Use identical patient cohort and folds for clinical-only and clinical-plus-expression comparisons.",
    "gene_identity": "All Entrez IDs are positive integers. Canonicalize by Entrez ID; preserve Hugo aliases in a feature dictionary; aggregate repeated gene rows by a fixed within-sample median of finite log2 intensities before splitting. This uses only the given sample, no outcomes or other samples. Do not silently keep-first, or choose duplicate rows using full-cohort variance.",
    "selection": "Predeclare a bounded gene budget (for example 100). In each inner training fold only, exclude genes above a prespecified missingness threshold and genes with zero variance, median-impute from training values, rank genes by variance on unstandardized log2 intensities with deterministic Entrez-ID tie breaking, and retain up to budget. Apply learned selection/imputation to validation/test; then fit scaling on training only. Repeat all steps in outer training fit. Do not standardize before variance ranking.",
    "missingness": "Only 16 nonfinite expression cells exist. Prefer training-gene-median imputation; a missingness cutoff should remain prespecified even though source missingness is tiny. Clinical missingness (notably stage 514/1980) also needs training-only handling rather than global complete-case selection that changes comparator populations.",
    "clinical_scope": "Exclude outcome/status/follow-up columns from predictors; do not present expression-derived INTCLUST/CLAUDIN_SUBTYPE/THREEGENE as purely clinical baseline variables. Treatment and derived molecular fields require explicit availability rationale."
  },
